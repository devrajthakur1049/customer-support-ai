# ==============================
# Server config
# ==============================
PORT=3001
NODE_ENV=development

# ==============================
# Supabase
# Get these from your Supabase project settings > API
# SERVICE ROLE KEY must only ever be used on the server, never in the client.
# ==============================
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ==============================
# AI Provider
# If OPENAI_API_KEY is not set, the server automatically falls back to a
# local mock provider so the app remains fully testable without a key.
# ==============================
AI_PROVIDER=openai
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4o-mini

# ==============================
# Business rules
# ==============================
CONFIDENCE_THRESHOLD=0.70

# ==============================
# n8n escalation webhook
# URL of the n8n Webhook node that receives escalation events.
# ==============================
N8N_ESCALATION_WEBHOOK_URL=http://localhost:5678/webhook/escalation

# ==============================
# Client (Vite) - safe to expose, no secrets
# ==============================
VITE_API_BASE_URL=http://localhost:3001/api
